{
  "manifest_version": 3,
  "name": "OTPeek",
  "version": "0.9.0",
  "description": "Mostra os códigos de verificação e links de confirmação que chegam no seu Gmail, processados localmente.",
  "key": "",
  "permissions": ["identity", "storage", "alarms", "downloads", "scripting"],
  "host_permissions": ["https://gmail.googleapis.com/*", "https://www.googleapis.com/oauth2/v3/userinfo"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OTPeek",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
